{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph6.local/schemas/ph6_authority_response_v1",
  "title": "PH6 Authority Response v1",
  "description": "Response from PSEUDO or SoSo to an AI authority request. Verdict uses PASS/DROP only.",
  "type": "object",
  "required": [
    "schema_id", "response_id", "request_id", "responder",
    "created_at_utc", "result", "verdict", "measurement_ids",
    "map_ids", "reason_summary", "hash", "authority_note"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "ph6.authority_response.v1" },
    "response_id": { "type": "string" },
    "request_id": { "type": "string" },
    "responder": {
      "type": "string",
      "enum": ["PSEUDO", "SOSO"]
    },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "result": {
      "type": "string",
      "enum": ["COMPLETE", "PARTIAL", "NO_DATA", "ERROR"]
    },
    "verdict": {
      "type": ["string", "null"],
      "enum": ["PASS", "DROP", null],
      "description": "PASS or DROP from PSEUDO only. Null for SoSo responses."
    },
    "measurement_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "map_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reason_summary": { "type": "string" },
    "hash": { "type": "string", "description": "BLAKE2b-256 of response content" },
    "authority_note": {
      "type": "string",
      "description": "AI may not revise this response. It is the deterministic authority record."
    }
  },
  "additionalProperties": false
}
