{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph6.local/schemas/sensors/failure_profile_v1",
  "title": "PH6 Sensor Failure Profile v1",
  "description": "Documents known failure modes, drift indicators, and disqualification thresholds for a sensor.",
  "type": "object",
  "required": [
    "schema_id", "profile_id", "sensor_id", "sensor_class",
    "failure_modes", "profile_hash"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "ph6.sensor.failure_profile.v1" },
    "profile_id": { "type": "string" },
    "sensor_id": { "type": "string" },
    "sensor_class": { "type": "string" },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["failure_class", "description", "detection_method"],
        "properties": {
          "failure_class": { "type": "string" },
          "description": { "type": "string" },
          "detection_method": { "type": "string" },
          "auto_disqualify": { "type": "boolean" },
          "creates_cram_r": { "type": "boolean" }
        }
      }
    },
    "drift_indicators": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sustained_failure_threshold": {
      "type": "object",
      "description": "Conditions under which sustained failure causes run termination"
    },
    "profile_hash": {
      "type": "string",
      "description": "BLAKE2b-256 of this failure profile"
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
