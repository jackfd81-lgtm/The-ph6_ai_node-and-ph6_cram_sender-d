{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph6.local/schemas/tokens/token_topology_graph_v1",
  "title": "PH6 Token Topology Graph v1",
  "description": "Describes the lineage and authority relationships between tokens across a session or evidence set.",
  "type": "object",
  "required": [
    "schema_id", "graph_id", "root_token_id", "nodes",
    "edges", "graph_hash", "created_at_utc"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "ph6.token.topology_graph.v1" },
    "graph_id": { "type": "string" },
    "root_token_id": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token_id", "token_class", "authority_level"],
        "properties": {
          "token_id": { "type": "string" },
          "token_class": { "type": "string" },
          "authority_level": { "type": "integer" },
          "status": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_token_id", "to_token_id", "edge_type"],
        "properties": {
          "from_token_id": { "type": "string" },
          "to_token_id": { "type": "string" },
          "edge_type": {
            "type": "string",
            "enum": [
              "DERIVED_FROM", "SUPERSEDES", "DISSENTS_FROM",
              "COMPRESSES", "RATIFIES", "REFERENCES", "CAUSED_BY"
            ]
          }
        }
      }
    },
    "graph_hash": {
      "type": "string",
      "description": "BLAKE2b-256 of this graph manifest"
    },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "scope": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
