  "generated_at_utc": "2026-05-16T00:00:00Z",
  "description": "Classification manifest for PH6 Ingest Compiler. Every source file maps to exactly one type. No file may appear in two types. Types are loaded in strict priority order.",

  "type_priority": {
    "LAW":     1,
    "SCHEMA":  2,
    "RUNTIME": 3,
    "STATE":   4,
    "GAP":     5,
    "TEST":    6,
    "HISTORY": 7
  },

  "type_descriptions": {
    "LAW":     "Immutable invariants, authority rules, forbidden terms, patch class definitions. These never change without a version bump and explicit human authorization.",
    "SCHEMA":  "Exact field contracts, schema lock registrations, message formats. Authoritative for all emitted records.",
    "RUNTIME": "Actual implementation state, service contracts, module descriptions, code-level facts. What the system does now.",
    "STATE":   "Current operational truth: open items, campaign status, handoff state, drift scan results. Changes frequently.",
    "GAP":     "Unresolved risks, open blockers, known unknowns. Must be explicit before any STOP-SHIP gate can close.",
    "TEST":    "Measurable verification evidence: campaign definitions, receipts, evidence runs. Runtime evidence outranks documentation.",
    "HISTORY": "Archived evolution: chronicles, superseded decisions, closed gate artifacts. Load only for forensic/full_canon builds."
  },

  "build_targets": {
    "minimal": {
      "types":       ["LAW", "SCHEMA"],
      "description": "Kernel invariants only. Fast session boot. No runtime, no history."
    },
    "engineering": {
      "types":       ["LAW", "SCHEMA", "RUNTIME", "STATE", "GAP"],
      "description": "Full working context for implementation tasks."
    },
    "governance": {
      "types":       ["LAW", "SCHEMA", "STATE", "GAP"],
      "description": "Drift enforcement and compliance checks. No runtime implementation detail."
    },
    "validation": {
      "types":       ["LAW", "SCHEMA", "TEST", "STATE"],
      "description": "Campaign execution and evidence verification. Runtime evidence is authoritative."
    },
    "forensic": {
      "types":       ["LAW", "SCHEMA", "RUNTIME", "STATE", "GAP", "TEST", "HISTORY"],
      "description": "Full picture for deep investigation. Includes archived evolution."
    },
    "full_canon": {
      "types":       ["LAW", "SCHEMA", "RUNTIME", "STATE", "GAP", "TEST", "HISTORY"],
      "description": "All files, priority-ordered. Formal record. Same as forensic but includes all registered files."
    }
  },

