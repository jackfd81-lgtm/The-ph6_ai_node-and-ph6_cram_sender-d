{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PH6 CRAM-PU Packet Schemas",
  "definitions": {
    "departure": {
      "type": "object",
      "required": ["schema","frame_id","payload_hash","hash_algorithm","media_type","size_bytes","departure_timestamp","authority"],
      "properties": {
        "schema":              {"type":"string","const":"ph6.raw_departure.v1"},
        "frame_id":            {"type":"integer","minimum":1},
        "payload_hash":        {"type":"string","pattern":"^[0-9a-f]{64}$"},
        "hash_algorithm":      {"type":"string","const":"BLAKE2b-256"},
        "media_type":          {"type":"string","enum":["FRAME","AUDIO","SENSOR"]},
        "size_bytes":          {"type":"integer","minimum":0},
        "departure_timestamp": {"type":"number"},
        "authority":           {"type":"string","const":"NONE"}
      },
      "additionalProperties": false
    },
    "arrival": {
      "type": "object",
      "required": ["schema","frame_id","payload_hash","hash_algorithm","transfer_status","arrival_timestamp","authority"],
      "properties": {
        "schema":            {"type":"string","const":"ph6.raw_arrival.v1"},
        "frame_id":          {"type":"integer","minimum":1},
        "payload_hash":      {"type":"string","pattern":"^[0-9a-f]{64}$"},
        "hash_algorithm":    {"type":"string","const":"BLAKE2b-256"},
        "transfer_status":   {"type":"string","enum":["OK","HASH_MISMATCH"]},
        "arrival_timestamp": {"type":"number"},
        "authority":         {"type":"string","const":"LANE_1"}
      },
      "additionalProperties": false
    },
    "verdict": {
      "type": "object",
      "required": ["schema","frame_id","verdict","metrics","input_hash","hash_algorithm","authority","soso_advisory"],
      "properties": {
        "schema":         {"type":"string","const":"ph6.pseudo_verdict.v1"},
        "frame_id":       {"type":"integer","minimum":1},
        "verdict":        {"type":"string","enum":["PASS","DROP"]},
        "reasons":        {"type":"array","items":{"type":"string"}},
        "metrics": {
          "type":"object",
          "required":["mean_brightness","byte_variance","laplacian_variance","contrast_stddev"],
          "properties": {
            "mean_brightness":    {"type":"number"},
            "byte_variance":      {"type":"number"},
            "laplacian_variance": {"type":"number"},
            "contrast_stddev":    {"type":"number"},
            "entropy":            {"type":"number"},
            "edge_density":       {"type":"number"}
          },
          "additionalProperties": false
        },
        "input_hash":     {"type":"string","pattern":"^[0-9a-f]{64}$"},
        "hash_algorithm": {"type":"string","const":"BLAKE2b-256"},
        "authority":      {"type":"string","const":"LANE_1"},
        "soso_advisory": {
          "type":"object",
          "description":"Advisory only — must not influence verdict",
          "required":["authority"],
          "properties": {
            "state":     {"type":"string"},
            "authority": {"type":"string","const":"NONE"}
          }
        },
        "timestamp":      {"type":"number"}
      }
    },
    "cram_commit": {
      "type": "object",
      "required": ["schema","frame_id","payload_hash","hash_algorithm","verdict","authority","prev_cram_hash","cram_hash"],
      "properties": {
        "schema":         {"type":"string","const":"ph6.cram_commit.v1"},
        "frame_id":       {"type":"integer","minimum":1},
        "payload_hash":   {"type":"string","pattern":"^[0-9a-f]{64}$"},
        "hash_algorithm": {"type":"string","const":"BLAKE2b-256"},
        "verdict":        {"type":"string","const":"PASS"},
        "authority":      {"type":"string","const":"LANE_1"},
        "prev_cram_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
        "cram_hash":      {"type":"string","pattern":"^[0-9a-f]{64}$"},
        "timestamp":      {"type":"number"}
      }
    },
    "shedding_event": {
      "type": "object",
      "required": ["schema","frame_id","policy_ref","reason","authority"],
      "properties": {
        "schema":     {"type":"string","const":"ph6.drop_shedding.v1"},
        "frame_id":   {"type":"integer","minimum":1},
        "policy_ref": {"type":"string","minLength":1},
        "reason":     {"type":"string"},
        "authority":  {"type":"string","const":"LANE_1"},
        "timestamp":  {"type":"number"}
      }
    }
  }
}
